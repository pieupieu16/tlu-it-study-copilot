# 1. Groq Cloud API (Ultra-low latency inference engine)
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# 2. Google Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# 3. OpenRouter API (Multi-model aggregation hub)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# AI Orchestration Routing Strategy
# Options: auto (Tiered: Groq -> Gemini -> OpenRouter -> Oracle), groq, gemini, openrouter
AI_PRIMARY_ROUTING=auto
AI_TIMEOUT_SECONDS=15
PORT=8000
HOST=0.0.0.0
